local GLASS_REFLECTANCE = 0.15
local isGlassyEnabled = false
local originalState = {}
local glassConnections = {}

local function getMyHead()
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("Head")
end

local function isMyHeadOrDescendant(part)
	local head = getMyHead()
	if not head then return false end
	return part == head or part:IsDescendantOf(head)
end

local function shouldAffect(part)
	if not part:IsA("BasePart") then return false end
	if isMyHeadOrDescendant(part) then return false end
	if part:IsA("Terrain") then return false end
	return true
end

local function saveAndApply(part)
	if originalState[part] then return end
	originalState[part] = {
		Material = part.Material,
		Reflectance = part.Reflectance,
		Transparency = part.Transparency,
		Color = part.Color,
	}
	part.Material = Enum.Material.Glass
	part.Reflectance = GLASS_REFLECTANCE
end

local function restore(part)
	local s = originalState[part]
	if not s then return end
	if part.Parent then
		part.Material = s.Material
		part.Reflectance = s.Reflectance
		part.Transparency = s.Transparency
		part.Color = s.Color
	end
	originalState[part] = nil
end

local function applyToAll()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if shouldAffect(obj) then
			saveAndApply(obj)
		end
	end
end

local function restoreAll()
	for part, _ in pairs(originalState) do
		restore(part)
	end
	originalState = {}
end

local function connectNew()
	table.insert(glassConnections, workspace.DescendantAdded:Connect(function(obj)
		if isGlassyEnabled and shouldAffect(obj) then
			task.wait()
			if obj.Parent then
				saveAndApply(obj)
			end
		end
	end))
end

local function disconnectAll()
	for _, c in ipairs(glassConnections) do c:Disconnect() end
	glassConnections = {}
end

local function atualizarBtnGlassy()
	if isGlassyEnabled then
		btnGlassyToggle.Text = "ON"
		btnGlassyToggle.BackgroundColor3 = COR_BOTAO_ATIVO
	else
		btnGlassyToggle.Text = "OFF"
		btnGlassyToggle.BackgroundColor3 = Color3.fromRGB(230, 200, 200)
	end
end
atualizarBtnGlassy()

btnGlassyToggle.MouseButton1Click:Connect(function()
	isGlassyEnabled = not isGlassyEnabled
	if isGlassyEnabled then
		applyToAll()
		connectNew()
	else
		restoreAll()
		disconnectAll()
	end
	atualizarBtnGlassy()
end)

-- Slider do Glassy (Vai de 0 a 50, e dividimos por 100 para ter o reflexo de 0.0 a 0.5)
criarSlider("Glassy Reflectance (0-50)", 0, 50, 15, false, function(valor)
	GLASS_REFLECTANCE = valor / 100
	if isGlassyEnabled then
		for part, _ in pairs(originalState) do
			if part.Parent then
				part.Reflectance = GLASS_REFLECTANCE
			end
		end
	end
end)

