local function criarLabel(texto)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 20)
	lbl.BackgroundTransparency = 1
	lbl.Text = texto
	lbl.TextColor3 = COR_TEXTO
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 12
	lbl.Parent = scroll
	return lbl
end

local function criarSlider(textoLabel, minVal, maxVal, valorInicial, isFloat, callback)
	criarLabel(textoLabel)
	
	local sliderFrame = Instance.new("Frame")
	sliderFrame.Size = UDim2.new(1, 0, 0, 26)
	sliderFrame.BackgroundColor3 = COR_FUNDO_OPCOES
	sliderFrame.BorderSizePixel = 0
	sliderFrame.Parent = scroll
	local sCorner = Instance.new("UICorner")
	sCorner.CornerRadius = UDim.new(0, 6)
	sCorner.Parent = sliderFrame
	
	local pctInicial = (valorInicial - minVal) / (maxVal - minVal)
	
	local sliderFill = Instance.new("Frame")
	sliderFill.Size = UDim2.new(pctInicial, 0, 1, 0)
	sliderFill.BackgroundColor3 = Color3.fromRGB(130, 170, 210)
	sliderFill.BorderSizePixel = 0
	sliderFill.Parent = sliderFrame
	local fCorner = Instance.new("UICorner")
	fCorner.CornerRadius = UDim.new(0, 6)
	fCorner.Parent = sliderFill
	
	local sliderText = Instance.new("TextLabel")
	sliderText.Size = UDim2.new(1, 0, 1, 0)
	sliderText.BackgroundTransparency = 1
	sliderText.Text = isFloat and string.format("%.1f", valorInicial) or tostring(math.floor(valorInicial))
	sliderText.TextColor3 = COR_TEXTO
	sliderText.Font = Enum.Font.GothamBold
	sliderText.TextSize = 12
	sliderText.ZIndex = 2
	sliderText.Parent = sliderFrame
	
	local draggingSlider = false
	
	local function atualizarSlider(input)
		local posX = math.clamp(input.Position.X - sliderFrame.AbsolutePosition.X, 0, sliderFrame.AbsoluteSize.X)
		local pct = posX / sliderFrame.AbsoluteSize.X
		local valorAtual = minVal + (pct * (maxVal - minVal))
		
		sliderFill.Size = UDim2.new(pct, 0, 1, 0)
		
		if isFloat then
			sliderText.Text = string.format("%.1f", valorAtual)
		else
			valorAtual = math.floor(valorAtual)
			sliderText.Text = tostring(valorAtual)
		end
		
		callback(valorAtual)
	end
	
	sliderFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
			atualizarSlider(input)
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			atualizarSlider(input)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)
end

